# Verify published assets with mise engine-pin before committing.
# Omastorm SE has published no engine release yet. Upstream's engine-0.1.5
# assets were pinned here, but they serve $XDG_RUNTIME_DIR/omastorm/, not
# omastorm-se/, so this UI could never reach them. Until the fork publishes
# (S9, OPEN-1), a checkout builds its own engine: bash scripts/cargo.sh build.
tag=engine-0.1.5
repo=wesleygrimes/omastorm
